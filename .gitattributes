# ========================
# Auto-detect text files and normalize line endings
# ========================
* text=auto

# ========================
# Source code — always LF
# ========================
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.sh   text eol=lf

# ========================
# Windows scripts — always CRLF
# ========================
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ========================
# Binary files — do not diff or merge
# ========================
*.jar  binary
*.class binary
*.war  binary
*.ear  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.p12  binary
*.jks  binary
*.key  binary
*.pem  binary
